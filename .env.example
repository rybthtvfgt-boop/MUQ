# قاعدة البيانات
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=muq_db

# التطبيق
PORT=5000
DEBUG=False
SECRET_KEY=your-secret-key-change-this-in-production

# Redis (اختياري لل caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email (اختياري للإشعارات)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@muq.com

# Upload limits
MAX_UPLOAD_SIZE=10485760

# Session configuration
SESSION_TIMEOUT=3600

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# Railway (إذا كنت تستخدم Railway)
# DB_HOST=(يملأ تلقائياً)
# DB_PORT=3306
# DB_USER=(يملأ تلقائياً)
# DB_PASSWORD=(يملأ تلقائياً)
# DB_NAME=railway

# Render (إذا كنت تستخدم Render)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Heroku (إذا كنت تستخدم Heroku)
# DB_URL=postgres://user:password@host:port/dbname
