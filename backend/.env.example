# Local Development
DEBUG=False
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=*
DB_ENGINE=sqlite
DB_NAME=muq_system
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
JWT_ACCESS_TOKEN_HOURS=2
JWT_REFRESH_TOKEN_DAYS=7
FACE_MATCH_THRESHOLD=0.5
FACE_CHECKIN_OPEN_MINUTES=15
FACE_CHECKIN_CLOSE_MINUTES=45
FACE_LATE_GRACE_MINUTES=10
FACE_OPERATOR_TYPES=teacher,gate,registration,administrative
CORS_ALLOWED_ORIGINS=http://localhost:8010,http://127.0.0.1:8010
CORS_ALLOW_ALL_ORIGINS=False
LANGUAGE_CODE=ar
TIME_ZONE=Asia/Baghdad

# Railway Production (set these in Railway environment variables)
# DEBUG=False
# SECRET_KEY=(generate strong key using secrets.token_urlsafe(50))
# ALLOWED_HOSTS=.railway.app,.vercel.app
# DB_ENGINE=postgresql
# DATABASE_URL=(auto-provided by Railway)
# CORS_ALLOWED_ORIGINS=https://*.railway.app,https://*.vercel.app
# ADMIN_PASSWORD=(strong password for admin user)
# ADMIN_EMAIL=admin@muq.com
